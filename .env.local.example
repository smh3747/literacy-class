# Supabase 설정 (기존 프로젝트 그대로 사용)
NEXT_PUBLIC_SUPABASE_URL=https://ngtfjvfteycvbmgeegoj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_bUt5iliSyM1vIJZXONgtiw_ktYsLoTJ

# 가입 코드 (외부에 노출 X)
ADMIN_SECRET_CODE=관리자만_아는_코드
TEACHER_SECRET_CODE=선생님만_아는_코드

# 서버 전용 키 (절대 NEXT_PUBLIC_ 접두사 금지)
# Supabase 대시보드 → Settings → API → service_role 키
SUPABASE_SERVICE_ROLE_KEY=서비스롤_키

# Vercel Cron 인증용 시크릿 (미설정 시 cron 라우트가 거부됨 — 필수)
# Vercel 환경변수에도 동일하게 등록해야 휴지통 자동 비우기가 동작한다
CRON_SECRET=임의의_긴_무작위_문자열

# NEIS 학교기본정보 OpenAPI 인증키 (서버 전용, 절대 NEXT_PUBLIC_ 접두사 금지)
# open.neis.go.kr → OpenAPI 신청 → 학교기본정보(schoolInfo) 인증키 발급
NEIS_API_KEY=

# 신규 학생 실명 암호화 키 (서버 전용, 절대 NEXT_PUBLIC_ 접두사 금지)
# AES-256-GCM용 32바이트 = hex 64자. 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel 환경변수에도 동일하게 등록해야 신규 학생 이름 잠금이 동작 (미설정 시 실명 평문 폴백)
# ⚠️ 키 분실 시 잠긴 실명 복호화 불가 — 안전하게 백업할 것
NAME_ENCRYPTION_KEY=
